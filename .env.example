# Hosted Supabase project for the NovaExplorer browser client.
# Copy this file to .env.local and fill in the values from your project.
# Dashboard: Project Settings → API Keys, or the Connect dialog.
# .env.local is Git-ignored. Do not commit it.
# Never put a secret key or service-role key in this file.

# Project URL, for example https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Publishable key. It starts with sb_publishable_ and is safe to use in the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy anon key. Used only when VITE_SUPABASE_PUBLISHABLE_KEY is empty.
# It is a long JWT that starts with eyJ. Prefer the publishable key.
VITE_SUPABASE_ANON_KEY=

# Gemini API configuration for AI-assisted educational features.
# Configure this in .env (or .env.local).
VITE_GEMINI_API_KEY=

